VITE_FIREBASE_API_KEY=
# Firebase 콘솔의 authDomain을 사용합니다. 서비스 도메인 변경 시에도 기존 값을 유지합니다.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_VAPID_KEY=
VITE_FIREBASE_KAKAO_PROVIDER_ID=oidc.kakao
# 이 JavaScript 키의 SDK 도메인에 https://spotitmap.kr를 등록합니다. 자세한 설정: docs/domain-setup.md
VITE_KAKAO_MAP_JS_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# Optional for local testing; set your Google Maps map ID for production.
VITE_GOOGLE_MAPS_MAP_ID=
