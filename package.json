{
  "name": "daymark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:people-profiles": "node --experimental-vm-modules --test tests/peopleProfiles.test.mjs",
    "test:image-editing": "node --experimental-strip-types --test tests/imageEditing.test.mjs",
    "test:chat-read-receipts": "node --experimental-strip-types --test tests/chatReadReceipts.test.mjs",
    "test:pin-themes": "node --experimental-strip-types --test tests/pinThemes.test.mjs",
    "test:pin-themes:integration": "firebase emulators:exec --config firebase.pin-themes.json --only auth,firestore --project demo-spotit-pins \"node --experimental-vm-modules --test tests/pinThemes.integration.test.mjs\"",
    "test:long-press": "node --experimental-strip-types --test tests/longPress.test.mjs",
    "test:moderation": "node --test tests/moderation.test.mjs",
    "test:profiles": "node --experimental-vm-modules --test tests/profiles.test.mjs",
    "test:maps": "node --experimental-strip-types --test tests/maps.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
